# Galeriku — Environment Configuration Template
# Salin file ini menjadi .env sebelum menjalankan docker-compose atau aplikasi

# 1. Platform & Server
APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# 2. Database PostgreSQL 16
DB_HOST=localhost
DB_PORT=5432
DB_USER=galeriku
DB_PASSWORD=galeriku_secret_pass
DB_NAME=galeriku_db
DB_SSLMODE=disable

# 3. Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MGMT_PORT=15672

# 5. Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# 6. Object Storage (MinIO / AWS S3)
S3_ENDPOINT=localhost:9000
MINIO_ROOT_USER=galeriku_admin
MINIO_ROOT_PASSWORD=galeriku_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_PRIVATE_VAULT=galeriku-master-vault
S3_BUCKET_PUBLIC_MEDIA=galeriku-public-media
S3_USE_SSL=false

# 7. Keamanan & Kredensial
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_12345
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# 8. Integrasi Pihak Ketiga (Placeholder untuk Development)
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder
MIDTRANS_IS_PRODUCTION=false
WHATSAPP_API_KEY=wa_dev_token_placeholder
