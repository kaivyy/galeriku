---
import '../styles/tokens.css';

interface Props {
  title: string;
  active?: string;
  authed?: boolean;
  role?: string;
}

const { title, active = '', authed = false, role = '' } = Astro.props;

const navItems = [
  { id: 'home', href: '/', label: 'Beranda' },
  { id: 'search', href: '/search/', label: 'Cari' },
  { id: 'cart', href: '/cart/', label: 'Keranjang' },
  { id: 'collection', href: '/collection/', label: 'Koleksi' },
  { id: 'studio', href: '/studio/', label: 'Studio' },
  { id: 'host', href: '/host/', label: 'Host' },
  { id: 'admin', href: '/admin/', label: 'Admin' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galeriku</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script>
      // Apply tokens before first paint to avoid a light flash on a dark site.
      document.documentElement.dataset.theme = 'dark';
    </script>
  </head>
  <body>
    <header class="app-header">
      <a class="brand" href="/">Galeriku</a>
      <nav class="pill-nav" aria-label="Utama">
        {navItems.map((item) => (
          <a href={item.href} class:list={[{ active: active === item.id }]}>{item.label}</a>
        ))}
      </nav>
      <div class="user-chip">
        {authed ? (
          <>
            {role && <span class={`role-badge role-${role}`}>{role}</span>}
            <button class="btn btn-ghost" id="logout-btn">Keluar</button>
          </>
        ) : (
          <a class="btn btn-primary" href="/login/">Masuk</a>
        )}
      </div>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="footer">
      <p><strong>Galeriku</strong>, platform foto event olahraga Indonesia</p>
    </footer>

    <script>
      // Header auth state: shared client logic kept tiny and framework-free.
      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem('galeriku_token');
        localStorage.removeItem('galeriku_user');
        window.location.href = '/';
      });
    </script>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { overflow-x: clip; }
      body {
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        overflow-x: clip;
        min-height: 100vh;
      }
      :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

      .app-header {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        padding: var(--space-3) var(--space-4);
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--color-border);
      }
      .brand {
        font-family: var(--font-display); font-weight: 700; font-size: 1.25rem;
        color: var(--color-text); text-decoration: none;
      }
      .pill-nav { display: none; gap: var(--space-1); align-items: center; }
      .pill-nav a {
        color: var(--color-text-muted); text-decoration: none; font-weight: 600; font-size: 0.875rem;
        padding: var(--space-2) var(--space-4); border-radius: var(--radius-full);
        transition: all var(--dur-fast) var(--ease-out);
        min-height: var(--tap-min); display: flex; align-items: center;
      }
      .pill-nav a:hover { color: var(--color-text); }
      .pill-nav a.active { background: var(--color-primary); color: var(--color-text); }
      @media (min-width: 1024px) { .pill-nav { display: flex; } }

      .user-chip { display: flex; align-items: center; gap: var(--space-2); }
      .role-badge { padding: 2px 8px; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 600; }
      .role-BUYER { background: rgba(79, 70, 229, 0.2); color: #A5B4FC; }
      .role-HOST_LEADER { background: rgba(245, 158, 11, 0.2); color: #FCD34D; }
      .role-CREATOR { background: rgba(16, 185, 129, 0.2); color: #6EE7B7; }
      .role-SUPER_ADMIN { background: rgba(239, 68, 68, 0.2); color: #FCA5A5; }

      .page { max-width: 1280px; margin: 0 auto; padding: var(--space-5) var(--space-4) var(--space-8); }
      .page-title { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; margin-bottom: var(--space-2); }
      .page-subtitle { color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: var(--space-5); }

      .footer { text-align: center; padding: var(--space-7) var(--space-4); color: var(--color-text-muted); font-size: 0.8125rem; }
      .footer strong { font-family: var(--font-display); color: var(--color-text); }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
        font-weight: 600; font-size: 1rem; padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-full); border: none; cursor: pointer;
        transition: all var(--dur-fast) var(--ease-out);
        min-height: var(--tap-min); min-width: var(--tap-min);
        text-decoration: none; font-family: var(--font-body);
      }
      .btn-primary { background: var(--color-primary); color: var(--color-text); }
      .btn-primary:hover { background: var(--color-primary-hover); }
      .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
      .btn-ghost { background: transparent; color: var(--color-text-muted); border: 1px solid var(--color-border); }
      .btn-ghost:hover { border-color: var(--color-primary); color: var(--color-text); }

      .card {
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-lg); padding: var(--space-5);
      }
      .card-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
      @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

      .form-field { margin-bottom: var(--space-4); }
      .form-field label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-2); }
      .form-field input {
        width: 100%; padding: var(--space-3) var(--space-4); background: var(--color-bg);
        border: 1px solid var(--color-border); border-radius: var(--radius-md);
        color: var(--color-text); font-size: 1rem; font-family: var(--font-body); min-height: var(--tap-min);
      }
      .form-field input:focus { outline: none; border-color: var(--color-primary); }
      .field-error { color: var(--color-danger); font-size: 0.75rem; margin-top: var(--space-1); display: none; }
      .field-error.show { display: block; }

      .empty-state { text-align: center; padding: var(--space-8) var(--space-4); color: var(--color-text-muted); }
      .empty-state .icon { font-size: 3rem; margin-bottom: var(--space-3); }

      .photo-grid { display: grid; gap: var(--space-2); grid-template-columns: repeat(2, minmax(0, 1fr)); }
      @media (min-width: 768px) { .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      @media (min-width: 1024px) { .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
      .photo-item {
        position: relative; aspect-ratio: 3 / 4; border-radius: var(--radius-md); overflow: hidden;
        background: var(--color-surface); cursor: pointer; border: none; padding: 0;
        transition: transform var(--dur-normal) var(--ease-out);
      }
      .photo-item:active { transform: scale(0.98); }
      .photo-item img { width: 100%; height: 100%; object-fit: cover; }
      .photo-placeholder {
        display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;
        background: linear-gradient(135deg, var(--color-surface), var(--color-bg));
        color: var(--color-text-muted); font-size: 0.75rem;
      }
      .price-tag {
        position: absolute; bottom: var(--space-2); left: var(--space-2);
        background: rgba(0, 0, 0, 0.7); color: var(--color-text);
        font-size: 0.75rem; font-weight: 700; padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-full); backdrop-filter: blur(4px);
      }

      .toast {
        position: fixed; bottom: var(--space-6); left: 50%; transform: translateX(-50%);
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-full); padding: var(--space-3) var(--space-5);
        font-size: 0.875rem; z-index: 300; display: none;
        max-width: 90%; text-align: center;
      }
      .toast.show { display: block; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
