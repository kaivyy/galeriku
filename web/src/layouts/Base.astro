---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';

interface Props {
  title: string;
  active?: string;
  authed?: boolean;
  role?: string;
}

const { title, active = '', authed = false, role = '' } = Astro.props;

const navItems = [
  { id: 'home', href: '/', label: 'Beranda' },
  { id: 'search', href: '/search/', label: 'Cari' },
  { id: 'cart', href: '/cart/', label: 'Keranjang' },
  { id: 'collection', href: '/collection/', label: 'Koleksi' },
  { id: 'studio', href: '/studio/', label: 'Studio' },
  { id: 'host', href: '/host/', label: 'Host' },
  { id: 'admin', href: '/admin/', label: 'Admin' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Galeriku</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script>
      // Light is the default theme; nothing to stamp before first paint.
    </script>
  </head>
  <body>
    <header class:list={["app-header", { "header-overlay": active === 'home' }]}>
      <a class="brand" href="/">Galeriku</a>
      <nav class="pill-nav" aria-label="Utama">
        {navItems.map((item) => (
          <a href={item.href} class:list={[{ active: active === item.id }]}>{item.label}</a>
        ))}
      </nav>
      <div class="user-chip">
        {authed ? (
          <>
            {role && <span class={`role-badge role-${role}`}>{role}</span>}
            <button class="btn btn-ghost" id="logout-btn">Keluar</button>
          </>
        ) : (
          <a class="btn btn-primary" href="/login/">Masuk</a>
        )}
      </div>
    </header>

    <main class:list={["page", { "page-home": active === 'home' }]}>
      <slot />
    </main>

    <!-- Mobile bottom nav: same five destinations as the Flutter shell -->
    <nav class:list={["bottom-nav", { "nav-overlay": active === 'home' }]} aria-label="Navigasi utama">
      <a href="/" class:list={[{ active: active === 'home' }]} aria-label="Beranda">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12L12 3L21 12M5 10V20H19V10"/></svg>
        <span>Beranda</span>
      </a>
      <a href="/search/" class:list={[{ active: active === 'search' }]} aria-label="Cari">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21L16.65 16.65"/></svg>
        <span>Cari</span>
      </a>
      <a href="/cart/" class:list={[{ active: active === 'cart' }]} aria-label="Keranjang">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1H4L5.44 12.59L18 17L23 7"/></svg>
        <span>Keranjang</span>
      </a>
      <a href="/collection/" class:list={[{ active: active === 'collection' }]} aria-label="Koleksi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9H21"/></svg>
        <span>Koleksi</span>
      </a>
      <a href="/login/" class:list={[{ active: active === 'login' }]} aria-label="Akun" id="bottom-nav-account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21V19C20 16 18 14 15 14H9C6 14 4 16 4 19V21"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Akun</span>
      </a>
    </nav>

    <footer class="footer">
      <p><strong>Galeriku</strong>, platform foto event olahraga Indonesia</p>
    </footer>

    <script>
      // Header auth state: shared client logic kept tiny and framework-free.
      // astro:page-load fires on first load and after every view-transition
      // swap, so the logout listener survives client-side navigation.
      document.addEventListener('astro:page-load', () => {
        const logoutBtn = document.getElementById('logout-btn');
        logoutBtn?.addEventListener('click', () => {
          localStorage.removeItem('galeriku_token');
          localStorage.removeItem('galeriku_user');
          window.location.href = '/';
        });

        // Reflect the stored session in the header: swap the standalone
        // Masuk link for a keluar chip when a token exists.
        const authed = Boolean(localStorage.getItem('galeriku_token'));
        const masuk = document.querySelector<HTMLAnchorElement>('.user-chip a[href="/login/"]');
        if (authed && masuk) {
          const chip = document.createElement('button');
          chip.className = 'btn btn-ghost';
          chip.id = 'logout-btn';
          chip.textContent = 'Keluar';
          chip.addEventListener('click', () => {
            localStorage.removeItem('galeriku_token');
            localStorage.removeItem('galeriku_user');
            window.location.href = '/';
          });
          masuk.replaceWith(chip);
        }
      });
    </script>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { overflow-x: clip; }
      body {
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        overflow-x: clip;
        min-height: 100vh;
      }
      :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

      .app-header {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        padding: var(--space-3) var(--space-4);
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--color-border);
      }
      @media (max-width: 1023px) {
        .app-header.header-overlay {
          background: transparent; border-bottom: none; backdrop-filter: none;
          position: fixed; left: 0; right: 0;
        }
        .app-header.header-overlay .brand { color: #FFFFFF; text-shadow: 0 1px 6px rgba(0,0,0,0.55); }
        .app-header.header-overlay .user-chip .btn { color: #FFFFFF; border-color: rgba(255,255,255,0.7); }
      }
      .brand {
        font-family: var(--font-display); font-weight: 700; font-size: 1.25rem;
        color: var(--color-text); text-decoration: none;
      }
      .pill-nav { display: none; gap: var(--space-1); align-items: center; }
      .pill-nav a {
        color: var(--color-text-muted); text-decoration: none; font-weight: 600; font-size: 0.875rem;
        padding: var(--space-2) var(--space-4); border-radius: var(--radius-full);
        transition: all var(--dur-fast) var(--ease-out);
        min-height: var(--tap-min); display: flex; align-items: center;
      }
      .pill-nav a:hover { color: var(--color-text); }
      .pill-nav a.active { background: var(--color-primary); color: var(--color-text); }
      @media (min-width: 1024px) { .pill-nav { display: flex; } }

      /* Bottom nav: mobile only (sama 5 tab dengan Flutter) */
      .bottom-nav {
        display: flex; justify-content: space-around; align-items: center;
        position: fixed; bottom: 0; left: 0; right: 0; height: 64px;
        background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(20px);
        border-top: 1px solid var(--color-border); z-index: 100;
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .bottom-nav a {
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        color: var(--color-text-muted); text-decoration: none;
        font-size: 10px; font-weight: 500; min-height: var(--tap-min);
        min-width: var(--tap-min); justify-content: center;
        transition: color var(--dur-fast) var(--ease-out);
      }
      .bottom-nav a.active { color: var(--color-primary); }
      .bottom-nav svg { width: 24px; height: 24px; }
      /* Home (Reels): the media runs edge-to-edge behind a SOLID dark bar,
         exactly like TikTok's opaque bottom bar. */
      .bottom-nav.nav-overlay {
        background: #000000; border-top: none;
      }
      .bottom-nav.nav-overlay a { color: rgba(255, 255, 255, 0.7); }
      .bottom-nav.nav-overlay a.active { color: #FFFFFF; }
      @media (min-width: 1024px) { .bottom-nav { display: none; } }

      /* Mobile layout: full-bleed, no page max-width, bottom padding */
      @media (max-width: 1023px) {
        .page { max-width: none; padding: var(--space-4) var(--space-3) 96px; }
        .page.page-home { padding: 0; }
        .app-header { padding: var(--space-2) var(--space-3); }
        .brand { font-size: 1.125rem; }
        .footer { padding-bottom: 96px; }
        .user-chip .btn { font-size: .8125rem; padding: 6px 12px; }
      }

      /* TikTok-style vertical feed for photo browsing on mobile.
         Full viewport height: the nav overlays the media instead of
         reserving layout space. */
      .feed-vertical {
        display: flex; flex-direction: column; gap: 0;
        scroll-snap-type: y mandatory; overflow-y: auto;
        height: 100dvh; -webkit-overflow-scrolling: touch;
      }
      .feed-card {
        position: relative; flex: 0 0 100%; aspect-ratio: 9 / 16;
        scroll-snap-align: start; scroll-snap-stop: always;
        overflow: hidden; background: var(--color-surface);
      }
      .feed-card img { width: 100%; height: 100%; object-fit: cover; }
      .feed-card .overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        /* Content sits flush with the bottom edge; the gradient paints the
           area behind it without adding layout height. */
        padding: 96px var(--space-4) var(--space-4);
        background: linear-gradient(transparent, rgba(0,0,0,0.72));
        color: #FFFFFF; pointer-events: none;
      }
      .feed-card .overlay .creator-row {
        display: flex; align-items: center; gap: var(--space-2);
        margin-bottom: var(--space-2);
      }
      .feed-card .overlay .creator-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        background: var(--color-primary); color: #FFFFFF;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.625rem; font-weight: 700; flex-shrink: 0;
      }
      .feed-card .overlay .creator-name { font-weight: 600; font-size: 0.875rem; }
      .feed-card .overlay .follow-btn {
        margin-left: var(--space-2); background: transparent;
        border: 1px solid #FFFFFF; color: #FFFFFF; border-radius: var(--radius-full);
        font-size: 0.6875rem; font-weight: 600; padding: 4px 12px;
        min-height: 32px; cursor: pointer; pointer-events: auto;
      }
      .feed-card .overlay .follow-btn.following { background: #FFFFFF; color: var(--color-text); }
      .feed-card .overlay .caption {
        font-size: 0.8125rem; opacity: 0.9; margin-bottom: var(--space-2);
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .feed-card .overlay .price { font-weight: 700; font-size: 1.125rem; }
      .feed-card .overlay .free-badge {
        display: inline-block; background: var(--color-accent); color: #0F172A;
        font-size: 0.6875rem; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-full);
      }
      .feed-card .actions {
        position: absolute; right: var(--space-2); bottom: var(--space-8);
        display: flex; flex-direction: column; gap: var(--space-3);
        align-items: center; color: #FFFFFF;
      }
      .feed-card .actions button {
        background: none; border: none; color: inherit; cursor: pointer;
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        font-size: 10px; min-height: var(--tap-min); min-width: var(--tap-min);
        justify-content: center; text-shadow: 0 1px 4px rgba(0,0,0,0.4);
      }
      .feed-card .actions button.liked svg { fill: var(--color-danger); stroke: var(--color-danger); }
      .feed-card .actions svg { width: 28px; height: 28px; }
      @media (min-width: 1024px) { .feed-vertical { display: none; } }
      @media (max-width: 1023px) { .photo-grid { display: none; } }

      .user-chip { display: flex; align-items: center; gap: var(--space-2); }
      .role-badge { padding: 2px 8px; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 600; }
      .role-BUYER { background: rgba(79, 70, 229, 0.12); color: #4338CA; }
      .role-HOST_LEADER { background: rgba(245, 158, 11, 0.15); color: #B45309; }
      .role-CREATOR { background: rgba(16, 185, 129, 0.12); color: #047857; }
      .role-SUPER_ADMIN { background: rgba(239, 68, 68, 0.12); color: #B91C1C; }

      .page { max-width: 1280px; margin: 0 auto; padding: var(--space-5) var(--space-4) var(--space-8); }
      .page-title { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; margin-bottom: var(--space-2); }
      .page-subtitle { color: var(--color-text-muted); font-size: 0.875rem; margin-bottom: var(--space-5); }

      .footer { text-align: center; padding: var(--space-7) var(--space-4); color: var(--color-text-muted); font-size: 0.8125rem; }
      .footer strong { font-family: var(--font-display); color: var(--color-text); }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
        font-weight: 600; font-size: 1rem; padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-full); border: none; cursor: pointer;
        transition: all var(--dur-fast) var(--ease-out);
        min-height: var(--tap-min); min-width: var(--tap-min);
        text-decoration: none; font-family: var(--font-body);
      }
      .btn-primary { background: var(--color-primary); color: var(--color-text); }
      .btn-primary:hover { background: var(--color-primary-hover); }
      .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
      .btn-ghost { background: transparent; color: var(--color-text-muted); border: 1px solid var(--color-border); }
      .btn-ghost:hover { border-color: var(--color-primary); color: var(--color-text); }

      .card {
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-lg); padding: var(--space-5);
      }
      .card-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
      @media (min-width: 768px) { .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

      .form-field { margin-bottom: var(--space-4); }
      .form-field label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: var(--space-2); }
      .form-field input {
        width: 100%; padding: var(--space-3) var(--space-4); background: var(--color-bg);
        border: 1px solid var(--color-border); border-radius: var(--radius-md);
        color: var(--color-text); font-size: 1rem; font-family: var(--font-body); min-height: var(--tap-min);
      }
      .form-field input:focus { outline: none; border-color: var(--color-primary); }
      .field-error { color: var(--color-danger); font-size: 0.75rem; margin-top: var(--space-1); display: none; }
      .field-error.show { display: block; }

      .empty-state { text-align: center; padding: var(--space-8) var(--space-4); color: var(--color-text-muted); }
      .empty-state .icon { font-size: 3rem; margin-bottom: var(--space-3); }

      .photo-grid { display: grid; gap: var(--space-2); grid-template-columns: repeat(2, minmax(0, 1fr)); }
      @media (min-width: 768px) { .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      @media (min-width: 1024px) { .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
      .photo-item {
        position: relative; aspect-ratio: 3 / 4; border-radius: var(--radius-md); overflow: hidden;
        background: var(--color-surface); cursor: pointer; border: none; padding: 0;
        transition: transform var(--dur-normal) var(--ease-out);
      }
      .photo-item:active { transform: scale(0.98); }
      .photo-item img { width: 100%; height: 100%; object-fit: cover; }
      .photo-placeholder {
        display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;
        background: linear-gradient(135deg, var(--color-surface), var(--color-bg));
        color: var(--color-text-muted); font-size: 0.75rem;
      }
      .price-tag {
        position: absolute; bottom: var(--space-2); left: var(--space-2);
        background: rgba(0, 0, 0, 0.7); color: var(--color-text);
        font-size: 0.75rem; font-weight: 700; padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-full); backdrop-filter: blur(4px);
      }

      .toast {
        position: fixed; bottom: var(--space-6); left: 50%; transform: translateX(-50%);
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-full); padding: var(--space-3) var(--space-5);
        font-size: 0.875rem; z-index: 300; display: none;
        max-width: 90%; text-align: center;
      }
      .toast.show { display: block; }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
