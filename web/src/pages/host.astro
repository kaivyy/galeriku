---
import Base from '../layouts/Base.astro';
---

<Base title="Host Portal" active="host">
  <h1 class="page-title">Host Portal</h1>
  <p class="page-subtitle">Kelola event, fotografer resmi, dan pembagian hasil</p>
  <div class="card-grid" id="host-stats" aria-live="polite"></div>
</Base>

<script>
  interface HostStats { organizations: number; members: number; pending_hosts: number; }

  // Same-origin via the Astro proxy (see astro.config.mjs).
  const apiBase = import.meta.env.PUBLIC_API_BASE || '';

  async function loadStats(): Promise<void> {
    const el = document.getElementById('host-stats');
    if (!el) return;
    const token = localStorage.getItem('galeriku_token');
    if (!token) { window.location.href = '/login/'; return; }
    try {
      const res = await fetch(`${apiBase}/api/v1/stats/host`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const payload = (await res.json()) as { success: boolean; data?: HostStats };
      const s = payload.data;
      el.innerHTML = s
        ? `
          <div class="card"><div class="stat"><span class="label">Organisasi</span><span class="value">${s.organizations}</span></div></div>
          <div class="card"><div class="stat"><span class="label">Anggota Aktif</span><span class="value">${s.members}</span></div></div>
          <div class="card"><div class="stat"><span class="label">Host Pending Verifikasi</span><span class="value">${s.pending_hosts}</span></div></div>`
        : '<div class="empty-state" style="grid-column:1/-1"><p>Gagal memuat statistik</p></div>';
    } catch {
      el.innerHTML = '<div class="empty-state" style="grid-column:1/-1"><p>Tidak dapat terhubung ke server</p></div>';
    }
  }

  void loadStats();
</script>

<style>
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat .label { font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .stat .value { font-family: var(--font-display); font-size: 2rem; font-weight: 700; }
</style>
